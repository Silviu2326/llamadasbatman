# Vendrava — Next.js static export (trailingSlash) on Apache / SWHosting
# Document root: ~/vendrava.com/web/
# Every route is <route>/index.html, served natively by DirectoryIndex.

Options -MultiViews -Indexes
DirectoryIndex index.html
RewriteEngine On

# --- Canonical host: redirect www -> non-www (single canonical host for SEO) ---
RewriteCond %{HTTP_HOST} ^www\.vendrava\.com$ [NC]
RewriteRule ^(.*)$ https://vendrava.com/$1 [R=301,L]

# --- Root "/" language redirect (keeps both locales crawlable) ---
# Spanish-preference browsers -> /es/ ; everyone else -> /en/ (x-default = en).
RewriteCond %{HTTP:Accept-Language} ^es [NC]
RewriteRule ^$ /es/ [R=302,L]
RewriteRule ^$ /en/ [R=302,L]

# --- Custom 404 (Next.js exported not-found page) ---
ErrorDocument 404 /404.html

# --- Caching ---
<IfModule mod_headers.c>
  # Security / trust headers (site-wide).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"

  # Hashed build assets are immutable and safe to cache for a year.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must always be revalidated so redeploys are picked up immediately
  # (prevents stale pages / cached 404s from being served).
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
