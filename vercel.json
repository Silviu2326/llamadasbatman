{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://llamadasspidermanback-production.up.railway.app/api/:path*" },
    { "source": "/health", "destination": "https://llamadasspidermanback-production.up.railway.app/health" },
    { "source": "/health/:path*", "destination": "https://llamadasspidermanback-production.up.railway.app/health/:path*" },
    { "source": "/((?!api|health).*)", "destination": "/index.html" }
  ]
}
