# URL pública o local del backend de llamadasrobin, sin / final.
CALLSROBIN_API_URL=http://localhost:3000

# Clave API de solo lectura creada en llamadasrobin (vk_...).
CALLSROBIN_API_KEY=vk_replace_me

# Escritura desactivada por defecto. Para activarla usa una segunda clave API
# con permisos de escritura y confirma cada tool con confirm=true.
CALLSROBIN_WRITE_ENABLED=false
CALLSROBIN_WRITE_API_KEY=vk_replace_me_write

# Tiempo máximo de cada petición al backend.
CALLSROBIN_TIMEOUT_MS=15000

# Límite defensivo del MCP para respuestas grandes.
CALLSROBIN_MAX_RESPONSE_BYTES=2000000
