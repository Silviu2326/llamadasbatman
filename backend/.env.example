DATABASE_URL=postgresql://user:password@localhost:5432/vozia
# Obligatoria para `npm test`; debe ser una base PostgreSQL aislada de desarrollo/producción.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/vozia_test
REDIS_URL=redis://localhost:6379
# Cola local durable; cambia a redis en despliegues que usen BullMQ.
WORKER_QUEUE_BACKEND=postgres
REDIS_ENABLED=false
JWT_SECRET=generate_a_random_secret_of_at_least_32_characters_before_starting
# Secreto distinto de JWT para state/PKCE de OAuth. Obligatorio al arrancar.
OAUTH_STATE_SECRET=generate_a_different_random_secret_of_at_least_32_characters
# Lista cerrada de orígenes del navegador (separada por comas). Sin comodines.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VOICE_SERVICE_URL=http://localhost:4000
VOICE_SERVICE_SECRET=change_me_voice_secret
# Capacidad efímera para upgrades de Twilio Media Streams. Si se omite, el
# backend utiliza TWILIO_AUTH_TOKEN; en producción se recomienda un secreto
# independiente y rotado. CORS_ORIGINS admite una lista separada por comas.
VOICE_STREAM_SECRET=
VOICE_STREAM_TOKEN_TTL_SECONDS=300
VOICE_SIM_MAX_CONCURRENT_PER_USER=1
VOICE_SIM_MAX_CONCURRENT_PER_ORG=3
VOICE_SIM_MAX_DURATION_SECONDS=600
# Único motor de voz bilingüe: Deepgram Flux Multilingual → Cerebras GPT-OSS 120B → Fish Audio S2.1 Pro.
# El idioma se selecciona por agente (en/es) y se envía como language_hint al STT.
# Sin las tres claves no arrancan ni la telefonía ni /voz/cabina.
DEEPGRAM_API_KEY=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
FISH_API_KEY=
# Voice model IDs opcionales de Fish Audio; se pueden sobreescribir por agente.
FISH_VOICE_ID_EN=
FISH_VOICE_ID_ES=
VOICE_EMOTION_RECOGNITION_ENABLED=false
VOICE_ENGINE_VERSION=3.0.0
VOICE_TURN_VERSION=1
VOICE_PROSODY_VERSION=1
VOICE_SALES_BRAIN_VERSION=1
VOICE_PLAYBOOK_VERSION=1
VOICE_EXPERIMENT_ID=
VOICE_CANARY_PERCENT=100
VOICE_JUDGE_RUBRIC_VERSION=1
S3_BUCKET=vozia-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
# CDN/custom-domain que expone únicamente el prefijo public/ del bucket.
# Obligatoria para POST /api/assets/:id/publish; el original sigue privado.
ASSET_PUBLIC_BASE_URL=
ASSET_MAX_BYTES=262144000
# Solo desarrollo: originales privados cuando S3 no está configurado.
ASSET_LOCAL_DIR=
GOOGLE_PLACES_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/meta/accounts/oauth/callback
META_GRAPH_API_VERSION=v23.0
META_TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN=
# Organic Leads / Google OAuth. Registra un callback por proveedor:
# /api/organic/integrations/{provider}/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Compatibilidad explícita: las credenciales del OAuth app suelen ser globales;
# los tokens de cada organización siguen aislados en OrganicIntegration. Déjalo
# en false si cada organización aporta su propio clientId/clientSecret mediante
# /api/integration-credentials/google.
GOOGLE_ALLOW_GLOBAL_FALLBACK=false
GOOGLE_OAUTH_REDIRECT_BASE_URL=http://localhost:3000
ORGANIC_TOKEN_ENCRYPTION_KEY=
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=
# Cifrado unificado con rotación (docs/plataforma-abierta/02-FUNDAMENTOS §4).
# Keyring opcional en formato `keyId:secreto,keyId2:secreto2` (secretos de
# >=32 caracteres; keyId con [A-Za-z0-9_-], sin puntos ni comas ni ':').
# La PRIMERA clave cifra, TODAS descifran: para rotar, añade la clave nueva
# delante y conserva las viejas detrás hasta recifrar los datos antiguos.
# Si se deja vacío, se sigue cifrando en v1 con la clave única de arriba.
# Los descifrados legacy (v1 y formatos de META/ORGANIC) siguen necesitando
# sus claves originales mientras existan payloads antiguos sin recifrar.
INTEGRATION_CREDENTIALS_ENCRYPTION_KEYS=
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Host público del backend. En producción debe ser HTTPS y no localhost.
PUBLIC_HOST=http://localhost:3000
# URL pública del script universal que se instala en webs de clientes.
# Por defecto el backend lo sirve en ${PUBLIC_HOST}/web-client.js; rellena
# esto solo si lo publicas en un CDN.
VENDRAVA_WEB_CLIENT_URL=
# Endpoint público de eventos del script universal (opcional; por defecto usa PUBLIC_HOST).
VENDRAVA_WEB_EVENTS_URL=https://api.vendrava.com/api/web-events/collect
# Conector Git: proveedor LLM del agente que prepara pull requests (por defecto
# el de la importación web u openai-chat) y API de GitHub (solo para GitHub Enterprise).
WEB_GIT_AGENT_PROVIDER_ID=
GITHUB_API_URL=
# Solo desarrollo/local: permite URLs privadas para Mautic. Mantener
# false en staging/producción para bloquear SSRF y callbacks no públicos.
ALLOW_PRIVATE_INTEGRATION_NETWORKS=false
PORT=3000
TRUST_PROXY=false
# Imágenes: gpt-image-1. Es el único generador de imagen del producto.
OPENAI_API_KEY=
# LLM alternativo abierto (solo BYOK): el modelo se configura por conexión de
# organización; este valor actúa como default operativo, nunca como clave.
OPENAI_CHAT_MODEL=
# Tarifas del modelo elegido para mostrar estimaciones comparables. No se
# hardcodea una tarifa porque cambia por modelo; 0 significa «sin valorar».
OPENAI_CHAT_INPUT_COST_CENTS_PER_1M_TOKENS=0
OPENAI_CHAT_OUTPUT_COST_CENTS_PER_1M_TOKENS=0
OPENAI_CHAT_RATE_VERSION=
# Onboarding asistido (POST /api/intake/website): proveedor preferido para
# leer la web de un cliente y proponer su ficha. Por defecto openai-chat, que
# es lo que pide el modo ChatGPT; el modelo concreto (p. ej. gpt-5.6-luna) se
# configura en la conexion OpenAI de la organizacion o en OPENAI_CHAT_MODEL.
# Si ese proveedor no esta disponible, el router elige otro y el analisis sigue.
WEBSITE_INTAKE_PROVIDER_ID=openai-chat
# Coste gestionado por imagen generada, en céntimos (ledger de consumo,
# lib/usage.ts). Default 4 si se deja vacío. Admite fracciones.
OPENAI_IMAGE_COST_CENTS=4
# Magnific (image.upscale, docs/plataforma-abierta/03-PROVEEDORES.md §5).
# Clave gestionada global; las orgs pueden aportar la suya (BYOK) desde el
# Centro de conexiones. Sin ninguna de las dos, el proveedor no ejecuta.
MAGNIFIC_API_KEY=
# Token propio que autentica el webhook entrante
# POST /api/webhooks/providers/magnific?token=... — obligatorio: sin él el
# receptor rechaza todos los avisos y los jobs no se cierran. La URL pública
# del webhook se construye con PUBLIC_HOST (definido más arriba).
MAGNIFIC_WEBHOOK_TOKEN=
# Opcional: secreto de firma HMAC que entrega Magnific al registrar el
# endpoint de webhooks (estilo Standard Webhooks, admite prefijo whsec_).
# Si se configura, la firma se verifica además del token.
MAGNIFIC_WEBHOOK_SIGNING_SECRET=
# Coste gestionado estimado de un upscale x2, en céntimos; escala linealmente
# con el factor (x4 = doble). Default 10 si se deja vacío.
MAGNIFIC_UPSCALE_COST_CENTS=10

# Runway Studio v1. Cuenta de organización (BYOK) tiene prioridad; esta clave
# global activa consumo gestionado. API oficial versionada 2024-11-06.
RUNWAYML_API_SECRET=
# Poll canónico de tasks remotos (Runway no documenta webhook nativo).
RUNWAY_POLL_INTERVAL_MS=30000
RUNWAY_POLL_MIN_AGE_MS=15000
RUNWAY_RESULT_MAX_BYTES=524288000
# Solo si Vendrava despliega un gateway propio que llama
# /api/webhooks/providers/runway. HMAC-SHA256 sobre "timestamp.rawBody".
RUNWAY_GATEWAY_WEBHOOK_SECRET=

# Studio v2: binarios instalados únicamente en la imagen del worker de media.
# Se invocan con spawn(shell:false), argumentos de presets y límites duros.
STUDIO_FFMPEG_PATH=ffmpeg
STUDIO_FFPROBE_PATH=ffprobe
STUDIO_FFMPEG_TIMEOUT_MS=600000
STUDIO_POST_MAX_INPUT_BYTES=1073741824
STUDIO_POST_MAX_OUTPUT_BYTES=262144000
# Cobro de créditos gestionados. Solo el literal "on" activa reserva y
# liquidación; cualquier otro valor mantiene ledger/estimaciones sin cobrar.
WALLET_ENFORCEMENT=off
# Panel creativo: cuántas lentes revisan cada pieza y cada artículo antes de
# guardarse (verdad → gancho → tijera → cierre). Cada lente es una llamada más
# al modelo por contenido: 4 cuesta unas cinco veces lo que costaba generar sin
# revisar. Sin definir corren las cuatro; 1 deja solo el editor adversario, que
# era el comportamiento anterior; 0 apaga la crítica sin tocar el enmascarado de
# datos personales ni la comprobación de especificidad, que son deterministas.
CONTENT_CRITIC_PASSES=
# Proveedor transaccional (Resend). Manda los avisos internos y los emails
# outbound de uno en uno, que no pueden ser una plantilla de Mautic porque el
# cuerpo cambia en cada envio. Sin estas dos, el outbound escrito por IA se
# redacta y se previsualiza, pero no sale.
RESEND_API_KEY=
EMAIL_FROM=
# Outbound frio: investigacion y redaccion. Corre entero sobre DeepSeek, cuya
# API es compatible con la de OpenAI. Sin DEEPSEEK_API_KEY el email se compone
# igual pero con un cuerpo de respaldo sin redactar.
# El modelo rapido extrae hechos (volumen); el razonador decide que buscar,
# escribe las tres versiones, las juzga y pule la ganadora.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-chat
DEEPSEEK_SMART_MODEL=deepseek-reasoner
DEEPSEEK_TIMEOUT_SECONDS=90
# Busqueda web propia: el modelo decide que consultar sobre cada prospecto.
# Sin clave, la investigacion se queda en la web del negocio.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_RATE_VERSION=brave:2026-08
# País de la búsqueda. US para la campaña de EE. UU.: en ES el modelo investiga
# el mercado equivocado y el correo sale con datos que no encajan.
BRAVE_SEARCH_COUNTRY=US
MAUTIC_BASE_URL=http://localhost:8100
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=
MAUTIC_WEBHOOK_SECRET=
# Solo para instalaciones locales antiguas; en producción se rechaza el
# secreto en query-string y se exige X-Mautic-Webhook-Secret o Bearer.
MAUTIC_WEBHOOK_ALLOW_QUERY_SECRET=false
# Posts orgánicos: Metricool API (Advanced/Custom). El blogId identifica la marca.
# METRICOOL_AUTO_PUBLISH=true hace que las piezas aprobadas se publiquen solas
# en la fecha programada. En false (por defecto) llegan como borrador y alguien
# le da a publicar en Metricool. Enciéndelo sabiendo que el texto sale a la
# cuenta de marca del cliente sin que lo haya leído una persona.
METRICOOL_AUTO_PUBLISH=false
METRICOOL_BASE_URL=https://app.metricool.com/api
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
METRICOOL_TIMEZONE=Europe/Madrid
METRICOOL_APP_URL=https://app.metricool.com

# Twilio voz y WhatsApp. El callback base debe ser público y HTTPS en producción.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_BASE_URL=http://localhost:3000
TWILIO_WHATSAPP_WELCOME_CONTENT_SID=
TWILIO_MX_NUMBERS={}
# Sólo migración controlada de instalaciones antiguas. En producción, cada
# org debe tener una credencial cifrada en /api/integration-credentials/twilio.
TWILIO_ALLOW_GLOBAL_FALLBACK=false
HUMAN_TRANSFER_NUMBER=

# ── Cumplimiento de llamada saliente ────────────────────────────────────────
# Prefijo que se asume cuando el teléfono llega sin país. 52 México, 1 EE.UU.
# El motor de voz admite inglés y español; el prefijo debe coincidir con el país
# de los números que marque esta instalación.
DEFAULT_PHONE_COUNTRY_CODE=1
# Franja horaria permitida, en hora LOCAL DE QUIEN RECIBE. El límite legal en
# EE. UU. es 8-21; se deja margen a propósito para no rozarlo.
CALL_HOUR_START=9
CALL_HOUR_END=20
# Zona horaria por defecto. Los números +52 la derivan de la lada y el resto de
# los leads la traen enriquecida (Lead.customFields.callTimeZone). Un +1 sin
# zona conocida NO se marca: no se puede probar la hora local. Rellenar esto
# solo si toda la operación vive en un único huso.
DEFAULT_CALL_TIMEZONE=
# Exige un ContactConsent(channel=voice) registrado antes de marcar.
# Obligatorio en EE. UU.: desde 2024 la voz de IA cuenta como voz artificial y
# llamar a un móvil sin consentimiento escrito son 500 $ por llamada.
REQUIRE_VOICE_CONSENT=false
# Excepción del fijo de empresa: la prohibición federal cubre móviles y líneas
# residenciales, no los fijos de empresa. Activar solo con el flujo revisado
# por un abogado y con lookupLineType() poblando Lead.customFields.lineType.
ALLOW_COLD_CALL_BUSINESS_LANDLINE=false
# Aviso de IA en la frase de apertura. No apagar: es obligatorio en varios
# estados y es lo que evita las quejas que originan las demandas.
DISCLOSE_AI=true
# Marca de la persona de respaldo, solo para cuando la llamada no trae ni guion
# ni perfil de negocio (cabina de pruebas). En una llamada real el prompt ya
# compone la identidad con la empresa de la organización. Sin valor, el agente
# no dice ninguna marca en vez de decir una equivocada.
VOICE_FALLBACK_BRAND=

# Verificación de buzones antes de enviar (MillionVerifier, ~0,0004 $/consulta).
# Sin clave, los correos salen sin verificar y el rebote puede quemar los
# buzones de envío; con ella, también se deduce el correo del dueño por patrón.
EMAIL_VERIFIER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Variables históricas de contenido; las llamadas usan FISH_API_KEY de arriba.
# Coste del plan de pago en céntimos por 1000 caracteres para el ledger.
# El modelo s2.1-pro-free siempre se registra con coste 0.
FISH_AUDIO_COST_CENTS_PER_1K_CHARS=
# Locuciones de contenido (no llamadas): servidor Chatterbox propio si lo tienes
# levantado, con ElevenLabs de respaldo. Ver services/contentVoiceover.service.ts.
CHATTERBOX_URL=http://127.0.0.1:8600
# Coste gestionado del TTS en céntimos por 1000 caracteres (ledger de consumo).
# Chatterbox es stack propio: default 1. ElevenLabs factura por carácter:
# default 15 (~tarifa Creator). Ambas admiten fracciones.
TTS_COST_CENTS_PER_1K_CHARS=1
ELEVENLABS_COST_CENTS_PER_1K_CHARS=15

# Analisis post-llamada con LLM de audio (Qwen3-Omni servido por vLLM u otro
# endpoint compatible OpenAI). Vacio = desactivado. Escribe analysis.json por sesion.
QWEN_OMNI_URL=
QWEN_OMNI_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
QWEN_OMNI_API_KEY=

# Durabilidad/operación de workers y llamadas a proveedores.
OUTBOX_LEASE_MS=300000
OUTBOX_MAX_ATTEMPTS=8
EMAIL_DELIVERY_LEASE_MS=120000
EMAIL_DELIVERY_MAX_ATTEMPTS=5
HEALTH_PROBE_EXTERNAL=false
REQUIRED_INTEGRATIONS=
# Token de lectura para /health/workers, /health/queues y /health/metrics.
# Generar uno aleatorio en el gestor de secretos; no dejar este valor vacío en producción.
OBSERVABILITY_TOKEN=
# Token distinto para operaciones autenticadas como replay de outbox.
OBSERVABILITY_MUTATION_TOKEN=
# Identificador secreto estable del worker dedicado; evita colisiones entre despliegues.
WORKER_HEARTBEAT_KEY=

# Variables usadas únicamente por el arnés de staging. El hash se calcula sobre
# host:puerto/base de STAGING_E2E_DATABASE_URL y nunca contiene la contraseña.
STAGING_E2E_DATABASE_TARGET_HASH=

# Worker en segundo plano (automatizaciones, outbox, scheduler temporal). Sin
# esto en el proceso worker, las automatizaciones quedan detenidas de forma
# silenciosa — ver GET /api/automations/health (P0-10/AU-15).
BACKGROUND_WORKERS_ENABLED=true
WORKER_QUEUE_POLL_MS=5000
# Cola universal de Jobs (capabilities, microapps y Marketplace).
JOB_DISPATCHER_POLL_MS=5000
JOB_DISPATCHER_BATCH_SIZE=10
JOB_DISPATCHER_LEASE_MS=300000
JOB_PROVIDER_TIMEOUT_HOURS=6
# Déjalo vacío para un identificador único por proceso; en despliegues
# controlados puede fijarse a un nombre secreto/estable por réplica.
JOB_DISPATCHER_WORKER_ID=
OUTBOX_POLL_MS=5000
TEMPORAL_TRIGGER_POLL_MS=300000
ORCHESTRATION_WORKER_ENABLED=true
ORCHESTRATION_WORKER_INTERVAL_MS=5000
ORCHESTRATION_MAX_ATTEMPTS=5
ORCHESTRATION_LEASE_MS=300000
ORCHESTRATION_BATCH_SIZE=10

# El seed no crea usuarios por defecto. Solo en NODE_ENV=development y con
# SEED_DEMO_USER=true se crea este admin explícitamente configurado.
SEED_DEMO_USER=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Stripe (facturación autogestionada) — al configurar estas variables se
# habilita el checkout y el portal de cliente en /configuracion. El webhook
# (POST /api/billing/webhook) actualiza Organization.plan.
# Un plan = una variable STRIPE_PRICE_<PLAN>, que priceIdForPlan() resuelve
# sola: añadir un plan es añadir su variable, sin tocar código.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mensual del producto A (web + SEO + sistema).
STRIPE_PRICE_PRO=
# Mensual del producto C, la marca blanca. El plan `agency` es el que trae el
# entitlement `multiworkspace` que abren las rutas de /white-label.
STRIPE_PRICE_AGENCY=

# ── Ledger de consumo: tarifas de coste (FUNDAMENTOS §3, rateVersion 2026-08) ──
# Coste para Vendrava, en céntimos. Registrar siempre, cobrar después: estas
# tarifas alimentan UsageRecord.costCents; el precio al cliente se decide aparte.
# DeepSeek, por millón de tokens (total prompt+respuesta).
DEEPSEEK_CHAT_COST_CENTS_PER_1M_TOKENS=25
DEEPSEEK_REASONER_COST_CENTS_PER_1M_TOKENS=120
# Resend, por email aceptado. Admite fracciones de céntimo.
RESEND_COST_CENTS_PER_EMAIL=0.09
# Voz (IA + telefonía), por minuto de llamada. Coherente con los 0,06 $/min
# de growthPredictor.service.ts (VOICE_COST_PER_MINUTE, que va en dólares).
VOICE_COST_PER_MINUTE_CENTS=6
# Reservas gestionadas: caducidad operativa (no libera consumo ya realizado).
WALLET_HOLD_TTL_HOURS=168
# Marketplace: firma HMAC de manifiestos editoriales y allowlist de revisores.
MARKETPLACE_MANIFEST_SIGNING_KEY=
MARKETPLACE_EDITOR_EMAILS=
