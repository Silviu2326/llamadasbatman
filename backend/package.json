{
  "name": "vozia-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file=.env --import=tsx --watch src/index.ts",
    "worker": "node --env-file=.env --import=tsx --watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file=.env --import=tsx prisma/seed.ts",
    "test": "node --env-file=.env --import=tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@deepgram/sdk": "^5.5.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^5.16.0",
    "@types/ws": "^8.18.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.7.0",
    "csv-parse": "^5.5.6",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.1",
    "openai": "^6.45.0",
    "socket.io": "^4.7.5",
    "twilio": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.0",
    "prisma": "^5.16.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
