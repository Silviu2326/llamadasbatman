# Template only. Merge into the backend/worker deployment environment after
# SIP 922118 was confirmed available by the owner (relayed 2026-09-16).
# No live credentials belong in git. Activation still requires deployment/testing.
ZADARMA_GATEWAY_ENABLED=false
ZADARMA_GATEWAY_EMBEDDED=true
ZADARMA_ORG_ID=
ZADARMA_GATEWAY_TOKEN=
ZADARMA_GATEWAY_URL=http://127.0.0.1:9093
# For a separate VPS, use its authenticated HTTPS gateway URL and set both
# ZADARMA_GATEWAY_EMBEDDED=false and ZADARMA_RECORDINGS_REMOTE=true on the API.
ZADARMA_RECORDINGS_REMOTE=false
ZADARMA_CONTROL_PORT=9093
ZADARMA_AUDIO_PORT=9092
ZADARMA_AMI_PORT=5038
ZADARMA_AMI_USER=vendrava-ai
ZADARMA_AMI_SECRET=
ZADARMA_PJSIP_ENDPOINT=zadarma-ai
ZADARMA_CALLER_ID=
ZADARMA_MAX_CONCURRENT=1
ZADARMA_MAX_CALL_SECONDS=1200
CALL_RECORDING_POLICY=always
# Must match extensions.conf, on a private persistent volume shared with Asterisk.
ZADARMA_RECORDING_DIR=/var/spool/asterisk/monitor/vendrava
# Required separately: existing DATABASE_URL and voice provider credentials.
# The Zadarma SIP password lives ONLY in the dedicated Asterisk pjsip.conf.
